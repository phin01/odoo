<?xml version="1.0"?>
<odoo>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
    
            <form string="Estate Property">
                <header>
                    <button name="action_set_sold" string="Set as Sold" type="object" class="btn-success" />
                    <button name="action_set_canceled" string="Set as Canceled" type="object" class="btn-danger"/>
                    <field name="state" string="State of Property" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold" />
                </header>
                <sheet>
                    <div class="row mb-6">
                        <div class="col-12">
                            <field name="name" nolabel="False" class="oe_inline h1" />
                        </div>
                        <div class="col-6">
                            Tags: <field name="property_tag_ids" widget="many2many_tags" options="{'no_create': true}" />
                        </div>
                    </div>

                    <div class="row mb-6">
                        <div class="col-4">
                            <group>
                                <!--<field name="state" string="State of Property" />-->
                                <field name="property_type_id" string="Type" options="{'no_create': true}" />
                                <field name="postcode" string="Postcode" />
                                <field name="date_availability" string="Available From" />
                            </group>
                        </div>
                        <div class="col-8">
                            <group>
                                <field name="expected_price" string="Expected Price" />
                                <field name="selling_price" string="Selling Price" />
                                <field name="best_price" string="Best Offer" />
                            </group>
                        </div>
                    </div>

                    <notebook>
                        <page string="Description">
                            <div class="row">
                                <div class="col-6">
                                    <group>
                                        <field name="description" string="Description" />
                                        <field name="bedrooms" string="Bedrooms" />
                                        <field name="living_area" string="Living Area" />
                                        <field name="facades" string="Facades" />
                                        <field name="garage" string="Garage" />
                                        <field name="garden" string="Garden" />
                                        <field name="garden_area" string="Garden Area (sqm)" />
                                        <field name="garden_orientation" string="Garden Orientation" />
                                        <field name="total_area" string="Total Area (sqm)" />
                                        <field name="active" string="Active" />
                                    </group>
                                </div>
                            </div>
                        </page>
                        <page string="Offers">
                            <field name="property_offer_ids" />
                        </page>
                        <page string="Other Info">
                            <div class="row">
                                <div class="col-6">
                                    <group>
                                        <field name="salesperson_id" string="Salesperson" options="{'no_create': true}" />
                                        <field name="buyer_id" string="Buyer" options="{'no_create': true}"/>
                                    </group>
                                </div>
                            </div>
                        </page>
                    </notebook>
                    
                </sheet>
            </form>
        </field>
    </record>

</odoo>