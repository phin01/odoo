<?xml version="1.0"?>
<odoo>
    <record id="res_users_view_form_properties" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.estate.properties</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Properties" name="estate_properties_page">
                    <field name="estate_property_ids" />
                </page>
            </xpath>
        </field>
    </record>

</odoo>
